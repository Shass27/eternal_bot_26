<?xml version="1.0" ?>
<robot name="eternal_bot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<!-- roller emulation (as in gz mecanum_drive.sdf): grip only along fdir1 (+-45deg), free-slip across it; launch file tags fdir1 with gz:expressed_in=base_link (URDF cannot), else it spins with the wheel -->
<xacro:macro name="wheel_gazebo" params="link fdir">
  <gazebo reference="${link}">
    <material>${body_color}</material>
    <mu1>1.0</mu1>
    <mu2>0.0</mu2>
    <fdir1>${fdir}</fdir1>
  </gazebo>
</xacro:macro>

<gazebo>
  <!-- holonomic drive without modelling rollers: plugin maps body twist to the 4 wheel velocities -->
  <plugin filename="gz-sim-mecanum-drive-system"
          name="gz::sim::systems::MecanumDrive">
    <front_left_joint>front_left_joint</front_left_joint>
    <front_right_joint>front_right_joint</front_right_joint>
    <back_left_joint>rear_left_joint</back_left_joint>
    <back_right_joint>rear_right_joint</back_right_joint>
    <wheel_separation>0.33</wheel_separation>
    <wheelbase>0.44</wheelbase>
    <wheel_radius>0.05</wheel_radius>
    <topic>cmd_vel</topic>
    <odom_topic>odom</odom_topic>
    <tf_topic>tf</tf_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>
    <odom_publisher_frequency>50</odom_publisher_frequency>
  </plugin>
  <!-- renders sensors (lidar) for sensor entities; empty.sdf doesn't load it, so it's loaded from the model; ogre needed on the VM -->
  <plugin filename="gz-sim-sensors-system"
          name="gz::sim::systems::Sensors">
    <render_engine>ogre</render_engine>
  </plugin>
  <plugin filename="gz-sim-joint-state-publisher-system"
          name="gz::sim::systems::JointStatePublisher">
    <topic>joint_states</topic>
  </plugin>
</gazebo>

<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <gravity>true</gravity>
</gazebo>

<xacro:wheel_gazebo link="front_left_1" fdir="1 -1 0"/>
<xacro:wheel_gazebo link="front_right_1" fdir="1 1 0"/>
<xacro:wheel_gazebo link="rear_right_1" fdir="1 -1 0"/>
<xacro:wheel_gazebo link="rear_left_1" fdir="1 1 0"/>

<gazebo reference="lidar_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <!-- 2D 360deg lidar at the top of the lidar mesh (lidar_1 moved to z=0.1062 so the scan plane clears the wheel tops at 0.076); 1 horizontal ring; gz_frame_id makes header.frame_id a real TF frame (URDF lidar_1), min range clears the lidar's own mesh -->
  <sensor name="lidar" type="gpu_lidar">
    <topic>scan</topic>
    <gz_frame_id>lidar_1</gz_frame_id>
    <update_rate>10</update_rate>
    <always_on>true</always_on>
    <visualize>false</visualize>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.12</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
  </sensor>
</gazebo>

</robot>
