<?xml version="1.0" ?>
<robot name="eternal_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find eternal_bot_description)/urdf/materials.xacro" />
<xacro:include filename="$(find eternal_bot_description)/urdf/eternal_bot.ros2control" />
<xacro:include filename="$(find eternal_bot_description)/urdf/eternal_bot.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.0 0.0 0.025600000000000005" rpy="0 0 0"/>
    <mass value="65.27180800000002"/>
    <inertia ixx="0.440701" iyy="1.844045" izz="2.256229" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find eternal_bot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find eternal_bot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

