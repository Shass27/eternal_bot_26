<joint name="front_left_joint" type="continuous">
  <origin xyz="0.22 0.14 0.0256" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="front_left_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="front _right_joint" type="continuous">
  <origin xyz="0.22 -0.14 0.0256" rpy="0 0 0"/>
