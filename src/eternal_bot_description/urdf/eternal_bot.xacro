<?xml version="1.0" ?>
<robot name="eternal_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find eternal_bot_description)/urdf/materials.xacro" />
<xacro:include filename="$(find eternal_bot_description)/urdf/eternal_bot.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.0 0.0 0.025600000000000005" rpy="0 0 0"/>
    <mass value="14"/>
    <inertia ixx="0.094525" iyy="0.395525" izz="0.483933" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find eternal_bot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find eternal_bot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="front_left_1">
  <inertial>
    <origin xyz="-2.220446049250313e-16 0.025000000000000022 1.97758476261356e-16" rpy="0 0 0"/>
    <mass value="0.4"/>
    <inertia ixx="0.000333" iyy="0.0005" izz="0.000333" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.22 -0.14 -0.0256" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find eternal_bot_description)/meshes/front_left_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision> <!-- sphere, not STL: mesh contacts ignore surface friction in gz; sphere + unrotated frame keeps fdir1 in link axes -->
    <origin xyz="0 0.025 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.05"/>
    </geometry>
  </collision>
</link>

<link name="front_right_1">
  <inertial>
    <origin xyz="2.220446049250313e-16 -0.025000000000000022 9.367506770274758e-17" rpy="0 0 0"/>
    <mass value="0.4"/>
    <inertia ixx="0.000333" iyy="0.0005" izz="0.000333" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.22 0.14 -0.0256" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find eternal_bot_description)/meshes/front_right_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision> <!-- sphere, not STL: mesh contacts ignore surface friction in gz; sphere + unrotated frame keeps fdir1 in link axes -->
    <origin xyz="0 -0.025 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.05"/>
    </geometry>
  </collision>
</link>

<link name="rear_right_1">
  <inertial>
    <origin xyz="-7.494005416219807e-16 -0.025000000000000022 -3.122502256758253e-17" rpy="0 0 0"/>
    <mass value="0.4"/>
    <inertia ixx="0.000333" iyy="0.0005" izz="0.000333" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.22 0.14 -0.0256" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find eternal_bot_description)/meshes/rear_right_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision> <!-- sphere, not STL: mesh contacts ignore surface friction in gz; sphere + unrotated frame keeps fdir1 in link axes -->
    <origin xyz="0 -0.025 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.05"/>
    </geometry>
  </collision>
</link>

<link name="rear_left_1">
  <inertial>
    <origin xyz="0.0 0.025000000000000022 1.3773704399255848e-15" rpy="0 0 0"/>
    <mass value="0.4"/>
    <inertia ixx="0.000333" iyy="0.0005" izz="0.000333" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.22 -0.14 -0.0256" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find eternal_bot_description)/meshes/rear_left_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision> <!-- sphere, not STL: mesh contacts ignore surface friction in gz; sphere + unrotated frame keeps fdir1 in link axes -->
    <origin xyz="0 0.025 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.05"/>
    </geometry>
  </collision>
</link>

<link name="lidar_1">
  <inertial>
    <origin xyz="-5.790023100122029e-18 5.790023100122029e-18 0.025" rpy="0 0 0"/>
    <mass value="0.15"/>
    <inertia ixx="0.000125" iyy="0.000125" izz="0.0001875" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.0 -0.0512" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find eternal_bot_description)/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.0 -0.0512" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find eternal_bot_description)/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="front_left_joint" type="continuous">
  <origin xyz="0.22 0.14 0.0256" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="front_left_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="front_right_joint" type="continuous">
  <origin xyz="0.22 -0.14 0.0256" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="front_right_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="rear_right_joint" type="continuous">
  <origin xyz="-0.22 -0.14 0.0256" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rear_right_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="rear_left_joint" type="continuous">
  <origin xyz="-0.22 0.14 0.0256" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rear_left_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="lidar_joint" type="fixed">
  <origin xyz="0.0 0.0 0.0512" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lidar_1"/>
</joint>

</robot>
